{"description":"Portfolio website di Cloudflare Pages dengan R2 (file) dan D1 (database)","devDependencies":{"wrangler":"^4.158.0"},"name":"portfolio-website","private":true,"scripts":{"db:create":"wrangler d1 create portfolio_db","db:migrate:local":"wrangler d1 migrations apply portfolio_db --local","db:migrate:remote":"wrangler d1 migrations apply portfolio_db --remote","deploy":"wrangler pages deploy public","dev":"wrangler pages dev public --d1 DB --r2 BUCKET","r2:create":"wrangler r2 bucket create portfolio-assets","secret:admin":"wrangler pages secret put ADMIN_TOKEN"},"version":"1.0.0"}